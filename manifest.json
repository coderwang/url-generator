{
  "manifest_version": 3,
  "name": "URL Generator",
  "version": "1.1.0",
  "description": "Generate URLs for multiple environments across different platforms. Save and manage URL snapshots. Support generating QR codes.",
  "author": "coderwsh",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "URL Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
